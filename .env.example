# Server Port
PORT=5000

# Supabase PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Storage image uploads (create a public bucket; never expose the service-role key to frontend)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[sb_secret-key or legacy service_role JWT]"
SUPABASE_SERVICE_ROLE_JWT="[legacy service_role JWT; only needed with a new sb_secret key]"
SUPABASE_STORAGE_BUCKET="product-images"
